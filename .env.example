DATABASE_URL=postgres://user:password@localhost:5432/till
# Set to true if your database requires SSL (Supabase, Render external URL)
PGSSL=false
JWT_SECRET=change-me-to-a-long-random-string
# First admin account, created only when the users table is empty
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=choose-a-strong-password
# Optional: enable card payments (use sk_test_ / pk_test_ keys while testing)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PORT=3000
